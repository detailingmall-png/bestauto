---
import reviewsData from '../../data/reviews.json';

const pageTitle = 'Защитная PPF-плёнка в Тбилиси — конфигуратор | BESTAUTO';
const pageDescription = 'Защита кузова автомобиля полиуретановой PPF-плёнкой в Тбилиси. Пакеты от 1 790 GEL, интерактивный расчёт стоимости и консультация в WhatsApp.';
const canonicalUrl = 'https://bestauto.ge/ru/ppf-shield-wrapping';
const socialImage = 'https://bestauto.ge/images/ppf-full-body-wrapping-guide-hero.webp';
const googleRating = reviewsData.overallRating.toFixed(1);
const googleReviewCount = reviewsData.totalReviews;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: 'Оклейка автомобиля защитной PPF-плёнкой',
      description: pageDescription,
      serviceType: 'Защита кузова автомобиля полиуретановой PPF-плёнкой',
      areaServed: { '@type': 'City', name: 'Тбилиси' },
      provider: { '@type': 'Organization', name: 'BESTAUTO', url: 'https://bestauto.ge/ru' },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'GEL',
        lowPrice: 1790,
        highPrice: 11220,
        offerCount: 15,
        url: canonicalUrl,
      },
    },
    {
      '@type': 'AutomotiveBusiness',
      '@id': 'https://bestauto.ge/ru/locations/guramishvili#business',
      name: 'BESTAUTO — Гурамишвили',
      url: 'https://bestauto.ge/ru/locations/guramishvili',
      telephone: '+995550000299',
      image: socialImage,
      priceRange: '₾₾₾',
      sameAs: ['https://maps.app.goo.gl/WBLHgeikidvdjsew7'],
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'проспект Гурамишвили, 78',
        addressLocality: 'Тбилиси',
        postalCode: '0167',
        addressCountry: 'GE',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '10:00',
        closes: '20:00',
      },
    },
    {
      '@type': 'AutomotiveBusiness',
      '@id': 'https://bestauto.ge/ru/locations/saburtalo#business',
      name: 'BESTAUTO — Сабуртало',
      url: 'https://bestauto.ge/ru/locations/saburtalo',
      telephone: '+995550000199',
      image: socialImage,
      priceRange: '₾₾₾',
      sameAs: ['https://maps.app.goo.gl/2vyDX1rNExQY4VER7'],
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'улица Анны Политковской, 51',
        addressLocality: 'Тбилиси',
        postalCode: '0179',
        addressCountry: 'GE',
      },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '10:00',
        closes: '20:00',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Видна ли плёнка и желтеет ли она со временем?',
          acceptedAnswer: { '@type': 'Answer', text: 'Качественная прозрачная PPF сохраняет исходный цвет и блеск. Современный материал устойчив к пожелтению, но результат зависит от качества плёнки, ухода и условий эксплуатации.' },
        },
        {
          '@type': 'Question',
          name: 'Нужно ли оклеивать автомобиль полностью?',
          acceptedAnswer: { '@type': 'Answer', text: 'Не обязательно. Для активной городской эксплуатации и трассы часто достаточно риск-зоны. Полная оклейка нужна, когда приоритет — единая защита всего кузова.' },
        },
        {
          '@type': 'Question',
          name: 'Какие царапины PPF восстанавливает от тепла?',
          acceptedAnswer: { '@type': 'Answer', text: 'От тепла могут уходить лёгкие поверхностные следы в верхнем слое плёнки. Глубокий порез, прокол или разрыв требует осмотра и возможной замены участка.' },
        },
        {
          '@type': 'Question',
          name: 'Можно ли оклеить автомобиль с пробегом и сколами?',
          acceptedAnswer: { '@type': 'Answer', text: 'Да, после осмотра и подготовки. Плёнка не маскирует глубокие сколы, царапины и следы ремонта, поэтому перед установкой мастер оценивает ЛКП.' },
        },
        {
          '@type': 'Question',
          name: 'Почему окончательная цена подтверждается после осмотра?',
          acceptedAnswer: { '@type': 'Answer', text: 'Перед работой нужно проверить состояние краски, следы ремонта и особенности конкретного кузова, которые могут повлиять на подготовку.' },
        },
        {
          '@type': 'Question',
          name: 'Почему в другой студии оклейка может стоить дешевле?',
          acceptedAnswer: { '@type': 'Answer', text: 'Цена зависит от материала, времени на подготовку, квалификации мастера, способа раскроя, обработки кромок и реальных гарантийных обязательств.' },
        },
      ],
    },
  ],
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ka" href="https://bestauto.ge/ppf-shield-wrapping" />
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href="https://bestauto.ge/en/ppf-shield-wrapping" />
    <link rel="alternate" hreflang="x-default" href="https://bestauto.ge/ppf-shield-wrapping" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_GE" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
